[configuration]

entry_symbol = "duel_native_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

windows.debug.x86_64 = "./duel_native.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./duel_native.windows.template_release.x86_64.dll"
android.debug.arm64 = "./libduel_native.android.template_debug.arm64.so"
android.release.arm64 = "./libduel_native.android.template_release.arm64.so"
