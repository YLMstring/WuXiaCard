; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="九宫论剑"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon_128.png"
boot_splash/show_image=true
boot_splash/bg_color=Color(0.0941176, 0.0470588, 0.027451, 1)
boot_splash/image="res://icon_android_adaptive_foreground_432.png"
boot_splash/minimum_display_time=1200
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Wuxia Card"

[internationalization]

locale/include_text_server_data=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
