[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tvec2 p = UV * 2.0 - 1.0;\n\tp.x *= 0.60;\n\tfloat edge = smoothstep(0.38, 0.98, length(p));\n\tCOLOR = vec4(0.12, 0.025, 0.006, edge * 0.82) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
shader = SubResource("Shader_vignette")

[sub_resource type="Shader" id="Shader_glow"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tfloat radius = length(UV - vec2(0.5)) * 2.0;\n\tfloat core = 1.0 - smoothstep(0.06, 0.92, radius);\n\tfloat halo = 1.0 - smoothstep(0.42, 1.0, radius);\n\tvec3 gold = mix(vec3(1.0, 0.40, 0.04), vec3(1.0, 0.88, 0.42), core);\n\tCOLOR = vec4(gold, (core * 0.34 + halo * 0.20)) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_glow"]
shader = SubResource("Shader_glow")

[sub_resource type="Shader" id="Shader_rays"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tvec2 p = UV - vec2(0.5);\n\tfloat radius = length(p) * 2.0;\n\tfloat angle = atan(p.y, p.x);\n\tfloat broad = pow(max(0.0, cos(angle * 8.0)), 10.0);\n\tfloat fine = pow(max(0.0, cos(angle * 17.0 + 0.45)), 24.0) * 0.52;\n\tfloat ring = smoothstep(0.10, 0.30, radius) * (1.0 - smoothstep(0.66, 1.0, radius));\n\tfloat alpha = (broad + fine) * ring * 0.48;\n\tCOLOR = vec4(1.0, 0.72, 0.18, alpha) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_rays"]
shader = SubResource("Shader_rays")

[sub_resource type="Shader" id="Shader_particles"]
code = "shader_type canvas_item;\n\nfloat hash(float value) {\n\treturn fract(sin(value * 91.3458) * 47453.5453);\n}\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tfloat dots = 0.0;\n\tvec3 tint = vec3(1.0, 0.73, 0.22);\n\tfor (int i = 0; i < 22; i++) {\n\t\tfloat fi = float(i) + 1.0;\n\t\tvec2 point = vec2(hash(fi * 1.71), hash(fi * 3.97));\n\t\tfloat size = mix(0.004, 0.012, hash(fi * 7.13));\n\t\tfloat dot_alpha = 1.0 - smoothstep(size * 0.25, size, distance(UV, point));\n\t\tdots += dot_alpha * mix(0.42, 1.0, hash(fi * 5.29));\n\t}\n\tCOLOR = vec4(tint, clamp(dots, 0.0, 1.0) * 0.88) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_particles"]
shader = SubResource("Shader_particles")

[sub_resource type="Shader" id="Shader_impact_ring"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tvec2 p = UV - vec2(0.5);\n\tp.x *= 1.24;\n\tfloat radius = length(p);\n\tfloat angle = atan(p.y, p.x);\n\tfloat inner_ring = 1.0 - smoothstep(0.005, 0.014, abs(radius - 0.305));\n\tfloat outer_ring = 1.0 - smoothstep(0.006, 0.017, abs(radius - 0.385));\n\tfloat wave = sin(angle * 8.0);\n\tfloat braid_a = 1.0 - smoothstep(0.004, 0.012, abs(radius - (0.438 + wave * 0.013)));\n\tfloat braid_b = 1.0 - smoothstep(0.004, 0.012, abs(radius - (0.438 - wave * 0.013)));\n\tfloat ornaments = pow(abs(cos(angle * 4.0)), 58.0);\n\tornaments *= 1.0 - smoothstep(0.014, 0.040, abs(radius - 0.482));\n\tfloat outer_glow = (1.0 - smoothstep(0.020, 0.070, abs(radius - 0.385))) * 0.17;\n\tfloat alpha = clamp(inner_ring * 0.62 + outer_ring + braid_a * 0.64 + braid_b * 0.44 + ornaments * 0.92 + outer_glow, 0.0, 1.0);\n\tvec3 red_gold = vec3(0.86, 0.22, 0.025);\n\tvec3 bright_gold = vec3(1.0, 0.82, 0.30);\n\tvec3 color = mix(red_gold, bright_gold, clamp(outer_ring + braid_a + ornaments, 0.0, 1.0));\n\tCOLOR = vec4(color, alpha) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_impact_ring"]
shader = SubResource("Shader_impact_ring")

[sub_resource type="Shader" id="Shader_flash"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec4 canvas_tint = COLOR;\n\tvec2 p = UV - vec2(0.5);\n\tp.x *= 1.20;\n\tfloat radius = length(p);\n\tfloat angle = atan(p.y, p.x);\n\tfloat center_cutout = smoothstep(0.255, 0.335, radius);\n\tfloat edge_fade = 1.0 - smoothstep(0.46, 0.68, radius);\n\tfloat long_spokes = pow(abs(cos(angle * 4.0)), 52.0);\n\tlong_spokes *= (1.0 - smoothstep(0.30, 0.66, radius));\n\tfloat short_spokes = pow(abs(cos(angle * 8.0 + 0.20)), 82.0);\n\tshort_spokes *= (1.0 - smoothstep(0.32, 0.52, radius));\n\tfloat needle_spokes = pow(abs(cos(angle * 12.0 - 0.12)), 112.0);\n\tneedle_spokes *= (1.0 - smoothstep(0.34, 0.48, radius));\n\tfloat burst_ring = (1.0 - smoothstep(0.010, 0.028, abs(radius - 0.35))) * 0.72;\n\tfloat alpha = (long_spokes + short_spokes * 0.70 + needle_spokes * 0.46 + burst_ring) * center_cutout * edge_fade;\n\tvec3 color = mix(vec3(1.0, 0.42, 0.035), vec3(1.0, 0.94, 0.62), clamp(long_spokes + burst_ring, 0.0, 1.0));\n\tCOLOR = vec4(color, clamp(alpha, 0.0, 1.0)) * canvas_tint;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_flash"]
shader = SubResource("Shader_flash")

